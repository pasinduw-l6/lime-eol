# =====================================================================
# Lime Technology Lifecycle & EOL Registry
# Copy to .env and fill in.  .env is git-ignored; this file is committed,
# so keep real secrets out of it.
# All values are validated at startup by
# backend/src/config/env.validation.ts — the app refuses to boot if one
# is missing or malformed.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Colombo
API_PORT=3000
# Allowed CORS origin (the Angular app, later)
APP_BASE_URL=http://localhost:4200

# ---------------------------------------------------------------------
# Database
# Host "db" is the compose service name. Use "localhost" only when
# running the API outside Docker against the published port 5432.
# ---------------------------------------------------------------------
POSTGRES_USER=lime
POSTGRES_PASSWORD=yl123
POSTGRES_DB=lime_eol
DATABASE_URL=postgresql://lime:yl123@db:5432/lime_eol?schema=public

# ---------------------------------------------------------------------
# Auth
# dev   = POST /api/v1/auth/dev-login issues a local JWT (blocked when
#         NODE_ENV=production)
# entra = Microsoft Entra ID bearer tokens validated via JWKS
# ---------------------------------------------------------------------
AUTH_MODE=dev
DEV_JWT_SECRET=yl123
# Required only when AUTH_MODE=entra — leave empty until Entra is set up.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_AUDIENCE=

# ---------------------------------------------------------------------
# EOL sync — endoflife.date API v1 (public, no API key needed)
# Product endpoint: {EOL_API_BASE}/products/{slug}/
# ---------------------------------------------------------------------
EOL_API_BASE=https://endoflife.date/api/v1
# Nightly sync at 02:00 in TZ
SYNC_CRON=0 2 * * *
# Run one sync immediately when the worker starts (handy while developing)
SYNC_ON_STARTUP=false
# A version counts as "EOL approaching" within this many days
STATUS_APPROACHING_DAYS=180
# HTTP client tuning (PLAN 10.2): timeout, retries, pacing between products
EOL_HTTP_TIMEOUT_MS=10000
EOL_RETRY_ATTEMPTS=3
EOL_RETRY_BASE_DELAY_MS=1000
EOL_REQUEST_DELAY_MS=1000
EOL_USER_AGENT=lime-eol-registry/0.1 (+internal)

# ---------------------------------------------------------------------
# Notifications — NOT WIRED UP YET (Phase 9).
# Leave NOTIFY_ENABLED=false: the worker only logs what it would send.
# Teams webhook URLs live per team in the database
# (team.teams_webhook_url), never here.
# ---------------------------------------------------------------------
NOTIFY_CRON=0 8 * * *
# Jira transitions, overdue plans, and end-of-life dates the vendor moved.
NOTIFY_EVENTS_CRON=0 11 * * *
# The Monday summary. Sent whether or not anything changed, so that a quiet
# week is distinguishable from a broken job.
NOTIFY_DIGEST_CRON=0 9 * * 1
# Power Automate "When a Teams webhook request is received" trigger URL.
# Holds a sig= credential — keep it out of version control.
TEAMS_WEBHOOK_URL=
NOTIFY_DRY_RUN=true
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lime Lifecycle <lifecycle@example.com>"

# ---------------------------------------------------------------------
# pgAdmin (optional: docker compose --profile tools up -d)
# ---------------------------------------------------------------------
PGADMIN_EMAIL=admin@linearsix.com
PGADMIN_PASSWORD=yl123

# ---------------------------------------------------------------------
# Jira (Cloud)
#
# All four must be set together, or all left blank. With them blank the
# registry runs normally and the plan panel reports "not connected" - end of
# life tracking never depends on Jira being reachable.
#
# JIRA_API_TOKEN carries full access as that user. It belongs here and only
# here: never committed, never logged, never returned by an endpoint. Create
# one at id.atlassian.com/manage-profile/security/api-tokens
#
# Cloud uses email + API token. Jira Data Center uses a bare personal access
# token instead and would need a second adapter.
# ---------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# How often the worker refreshes linked issues.
JIRA_SYNC_CRON=*/15 * * * *
JIRA_HTTP_TIMEOUT_MS=10000

# Serves invented issues so the Jira panel can be demonstrated without access
# to a real Jira. Must be turned on deliberately - it is never a fallback for
# missing credentials, it wins over them when both are set, and the app
# refuses to start with it on when NODE_ENV=production.
JIRA_DEMO=false

# Raise a Jira issue automatically whenever an upgrade is planned, with one
# sub-task per environment it affects. Off by default, so planning never
# reaches a real board until someone decides it should.
#
# Failure never blocks planning: the upgrade is still recorded and the reason
# is stored on the plan, which can raise its issue later from the plan itself
# (POST /upgrade-actions/{id}/jira/create). That endpoint also covers plans
# made before this was switched on.
JIRA_CREATE_ON_PLAN=false

# scoped = a token created with "Create API token with scopes" (restricted to
# the scopes you picked, sent via Atlassian's gateway). classic = the plain
# "Create API token" button (full account access, sent to the site URL).
# The two look identical as strings, so this has to be stated.
JIRA_TOKEN_TYPE=scoped

# ---------------------------------------------------------------------
# Single sign-on
#
# dev   = email and password issued by this API. Local work only; the app
#         refuses to start with this when NODE_ENV=production.
# entra = Microsoft. Set the tenant id and audience; the issuer and key set
#         are derived from them.
# oidc  = any other provider (Keycloak and so on) via explicit URLs.
#
# Users are matched by EMAIL against the app's own user table, never by the
# provider's subject id - so the same account list survives a change of
# tenant or provider. An address we do not know signs in as a viewer.
# ---------------------------------------------------------------------
AUTH_MODE=dev

# AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_AUDIENCE=

# AUTH_MODE=oidc, e.g. Keycloak:
#   OIDC_ISSUER=https://keycloak.example.com/realms/lime
#   OIDC_JWKS_URI=https://keycloak.example.com/realms/lime/protocol/openid-connect/certs
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=

# ---------------------------------------------------------------------
# AUTH_MODE=saml — Microsoft sign-in through an Entra enterprise
# application. Microsoft proves who someone is once, at sign-in; every
# request after that carries this API's own bearer token, exactly as in
# dev mode.
#
# The first three values are copied out of the enterprise application's
# "Set up single sign-on with SAML" pane. The labels there are quoted
# below, because they do not match the SAML specification's own names.
#
# Roles are decided here, not in Entra: the six addresses in
# prisma/seed/users.seed.ts are EDITORs, and anyone else in the directory
# who signs in gets a VIEWER account created for them.
# ---------------------------------------------------------------------

# Entra's "Login URL".
SAML_ENTRY_POINT=
# Entra's "Microsoft Entra Identifier". Optional, but without it the
# assertion's issuer goes unchecked.
SAML_IDP_ISSUER=
# The "Certificate (Base64)" download. Paste the base64 on one line; the
# PEM header and footer are stripped if you leave them in.
SAML_CERT=
# Our "Identifier (Entity ID)" — what this API calls itself to Entra.
# Any stable URI: the app's own base URL is the conventional choice.
SAML_SP_ENTITY_ID=
# Entra's "Reply URL". Defaults to APP_BASE_URL + /api/v1/auth/saml/acs,
# which is right unless the API is reached on a different host.
SAML_CALLBACK_URL=

# ---------------------------------------------------------------------
# AUTH_MODE=oidc-web — Microsoft sign-in through an Entra app
# registration, by the authorization code flow.
#
# The browser is sent to Microsoft, returns here with a code, and this
# API exchanges it for tokens over a back channel using the secret.
# Nothing Microsoft issues ever reaches the browser: what the person
# ends up holding is this app's own session token, the same one the
# password login issues. So AUTH_MODE=dev still works locally with no
# Microsoft involvement at all.
#
# Whoever administers the tenant must register this exact redirect URI
# on the app registration, under Authentication -> Web:
#
#   <APP_BASE_URL>/api/v1/auth/oidc/callback
#
# No API permissions and no admin consent are needed - signing in only
# reads the user's own identity, which the default User.Read covers.
#
# Roles are decided here, not in Entra: the six addresses in
# prisma/seed/users.seed.ts are EDITORs, and anyone else in the
# directory who signs in gets a VIEWER account created for them.
# ---------------------------------------------------------------------

# Directory (tenant) ID, from the app registration's Overview page.
OIDC_WEB_TENANT_ID=
# Application (client) ID, same page.
OIDC_WEB_CLIENT_ID=
# The secret VALUE, not the Secret ID. Shown once when created; if it
# was not copied then, a new one has to be generated. Note the expiry
# date - sign-in stops working the day it lapses.
OIDC_WEB_CLIENT_SECRET=
# Defaults to APP_BASE_URL + /api/v1/auth/oidc/callback. Only set this
# if what is registered in Entra differs from that.
OIDC_WEB_REDIRECT_URI=

# ---------------------------------------------------------------------
# Session signing
#
# Signs the tokens this API issues once an identity provider has
# vouched for someone. Required by AUTH_MODE=saml and oidc-web; the
# dev login uses DEV_JWT_SECRET instead.
#
# Changing it signs everyone out, which is the way to revoke every
# session at once.
#
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------
SESSION_SECRET=
