# =====================================================================
# Lime Technology Lifecycle & EOL Registry
# Copy to .env and fill in.  .env is git-ignored; this file is committed,
# so keep real secrets out of it.
# All values are validated at startup by
# backend/src/config/env.validation.ts — the app refuses to boot if one
# is missing or malformed.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Colombo
API_PORT=3000
# Allowed CORS origin (the Angular app, later)
APP_BASE_URL=http://localhost:4200

# ---------------------------------------------------------------------
# Database
# Host "db" is the compose service name. Use "localhost" only when
# running the API outside Docker against the published port 5432.
# ---------------------------------------------------------------------
POSTGRES_USER=lime
POSTGRES_PASSWORD=yl123
POSTGRES_DB=lime_eol
DATABASE_URL=postgresql://lime:yl123@db:5432/lime_eol?schema=public

# ---------------------------------------------------------------------
# Auth
# dev   = POST /api/v1/auth/dev-login issues a local JWT (blocked when
#         NODE_ENV=production)
# entra = Microsoft Entra ID bearer tokens validated via JWKS
# ---------------------------------------------------------------------
AUTH_MODE=dev
DEV_JWT_SECRET=yl123
# Required only when AUTH_MODE=entra — leave empty until Entra is set up.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_AUDIENCE=

# ---------------------------------------------------------------------
# EOL sync — endoflife.date API v1 (public, no API key needed)
# Product endpoint: {EOL_API_BASE}/products/{slug}/
# ---------------------------------------------------------------------
EOL_API_BASE=https://endoflife.date/api/v1
# Nightly sync at 02:00 in TZ
SYNC_CRON=0 2 * * *
# Run one sync immediately when the worker starts (handy while developing)
SYNC_ON_STARTUP=false
# A version counts as "EOL approaching" within this many days
STATUS_APPROACHING_DAYS=180
# HTTP client tuning (PLAN 10.2): timeout, retries, pacing between products
EOL_HTTP_TIMEOUT_MS=10000
EOL_RETRY_ATTEMPTS=3
EOL_RETRY_BASE_DELAY_MS=1000
EOL_REQUEST_DELAY_MS=1000
EOL_USER_AGENT=lime-eol-registry/0.1 (+internal)

# ---------------------------------------------------------------------
# Notifications — NOT WIRED UP YET (Phase 9).
# Leave NOTIFY_ENABLED=false: the worker only logs what it would send.
# Teams webhook URLs live per team in the database
# (team.teams_webhook_url), never here.
# ---------------------------------------------------------------------
NOTIFY_CRON=0 8 * * *
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lime Lifecycle <lifecycle@example.com>"

# ---------------------------------------------------------------------
# pgAdmin (optional: docker compose --profile tools up -d)
# ---------------------------------------------------------------------
PGADMIN_EMAIL=admin@linearsix.com
PGADMIN_PASSWORD=yl123
