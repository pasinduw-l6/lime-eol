
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum ComponentType {
  DATABASE
  RUNTIME
  FRAMEWORK
  OS
  CONTAINER
  ORCHESTRATION
  MESSAGING
  LIBRARY
  OTHER
}

enum CycleRule {
  MAJOR
  MAJOR_MINOR
}

enum EolField {
  EOL
  EOAS
  EOES
}

enum EolSource {
  API
  MANUAL
}

enum Environment {
  DEV
  UAT
  PROD
}

enum DeploymentLocation {
  EC2
  CUSTOMER_SITE
}

enum ActionStatus {
  NOT_STARTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
}


enum CommStatus {
  NOT_REQUIRED
  PENDING
  SENT
  ACKNOWLEDGED
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ONBOARDING
  PAUSED
}

enum Channel {
  EMAIL
  TEAMS
}

enum ComponentChangeType {
  INSTALL
  UPGRADE
  DOWNGRADE
  REMOVE
}

enum ChangeReason {
  INITIAL_RECORD
  PLANNED_UPGRADE
  SECURITY_PATCH
  ROLLBACK
  DRIFT_CORRECTION
  DECOMMISSION
}


model Technology {
  id            String        @id @default(uuid(7)) @db.Uuid
  name          String        @unique
  componentType ComponentType @map("component_type")
  vendor        String?
  eolSlug       String?       @unique @map("eol_slug")
  cycleRule     CycleRule     @default(MAJOR) @map("cycle_rule")
  eolField      EolField      @default(EOL) @map("eol_field")
  referenceUrl  String?       @map("reference_url")
  iconSlug      String?       @map("icon_slug")
  iconColour    String?       @map("icon_colour")
  notes         String?
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cycles   TechnologyCycle[]
  syncLogs EolSyncLog[]
  changes  ComponentChange[]

  @@index([archivedAt])
  @@map("technology")
}

model TechnologyCycle {
  id                 String    @id @default(uuid(7)) @db.Uuid
  technologyId       String    @map("technology_id") @db.Uuid
  cycle              String
  label              String?
  releaseDate        DateTime? @map("release_date") @db.Date
  eolDate            DateTime? @map("eol_date") @db.Date
  activeSupportEnd   DateTime? @map("active_support_end") @db.Date
  extendedSupportEnd DateTime? @map("extended_support_end") @db.Date
  isLts              Boolean   @default(false) @map("is_lts")
  isMaintained       Boolean   @default(true) @map("is_maintained")
  latestPatch        String?   @map("latest_patch")
  latestPatchDate    DateTime? @map("latest_patch_date") @db.Date
  eolSource          EolSource @default(API) @map("eol_source")
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  technology     Technology               @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  versions       TechnologyVersion[]
  history        TechnologyCycleHistory[]
  upgradeActions UpgradeAction[]
  notifications  NotificationLog[]

  @@unique([technologyId, cycle])
  @@index([eolDate])
  @@index([eolSource])
  @@map("technology_cycle")
}

model TechnologyVersion {
  id                String   @id @default(uuid(7)) @db.Uuid
  technologyCycleId String   @map("technology_cycle_id") @db.Uuid
  fullVersion       String   @map("full_version")
  major             Int
  minor             Int?
  patch             Int?
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cycle               TechnologyCycle        @relation(fields: [technologyCycleId], references: [id], onDelete: Restrict)
  limeVersions        LimeVersionComponent[]
  deploymentOverrides DeploymentComponent[]
  changesFrom         ComponentChange[]      @relation("ChangeFrom")
  changesTo           ComponentChange[]      @relation("ChangeTo")

  @@unique([technologyCycleId, fullVersion])
  @@index([technologyCycleId, major, minor, patch])
  @@map("technology_version")
}

model TechnologyCycleHistory {
  id                String    @id @default(uuid(7)) @db.Uuid
  technologyCycleId String    @map("technology_cycle_id") @db.Uuid
  field             String
  oldValue          String?   @map("old_value")
  newValue          String?   @map("new_value")
  source            EolSource @default(API)
  changedAt         DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)

  cycle TechnologyCycle @relation(fields: [technologyCycleId], references: [id], onDelete: Cascade)

  @@index([technologyCycleId, changedAt])
  @@map("technology_cycle_history")
}


model LimeVersion {
  id            String    @id @default(uuid(7)) @db.Uuid
  versionNumber String    @unique @map("version_number")
  releaseDate   DateTime? @map("release_date") @db.Date
  notes         String?
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  components  LimeVersionComponent[]
  deployments Deployment[]

  @@map("lime_version")
}

model LimeVersionComponent {
  limeVersionId String @map("lime_version_id") @db.Uuid
  techVersionId String @map("tech_version_id") @db.Uuid

  limeVersion LimeVersion       @relation(fields: [limeVersionId], references: [id], onDelete: Cascade)
  techVersion TechnologyVersion @relation(fields: [techVersionId], references: [id], onDelete: Cascade)

  @@id([limeVersionId, techVersionId])
  @@index([techVersionId])
  @@map("lime_version_component")
}


model Customer {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @unique
  code       String?   @unique
  contact    String?
  notes      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects    Project[]
  deployments Deployment[]

  @@index([archivedAt])
  @@map("customer")
}

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  name        String
  code        String        @unique
  limeVersion String?       @map("lime_version")
  status      ProjectStatus @default(ACTIVE)
  startedAt   DateTime?     @map("started_at") @db.Date
  notes       String?
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deployments Deployment[]
  engineers   ProjectEngineer[]

  @@index([customerId])
  @@map("project")
}

model ProjectEngineer {
  projectId String  @map("project_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isLead    Boolean @default(false) @map("is_lead")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_engineer")
}

model Deployment {
  id             String             @id @default(uuid(7)) @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  projectId      String             @map("project_id") @db.Uuid
  limeVersionId  String?            @map("lime_version_id") @db.Uuid
  name           String
  environment    Environment
  location       DeploymentLocation
  locationDetail String?            @map("location_detail")
  notes          String?
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  limeVersion    LimeVersion?              @relation(fields: [limeVersionId], references: [id], onDelete: Restrict)
  owners         DeploymentOwner[]
  overrides      DeploymentComponent[]
  upgradeActions UpgradeActionDeployment[]
  changes        ComponentChange[]

  @@unique([projectId, environment])
  @@index([environment])
  @@index([projectId])
  @@index([archivedAt])
  @@map("deployment")
}

model DeploymentOwner {
  deploymentId String  @map("deployment_id") @db.Uuid
  teamId       String  @map("team_id") @db.Uuid
  isPrimary    Boolean @default(false) @map("is_primary")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([deploymentId, teamId])
  @@index([teamId])
  @@map("deployment_owner")
}

model DeploymentComponent {
  deploymentId  String @map("deployment_id") @db.Uuid
  techVersionId String @map("tech_version_id") @db.Uuid

  deployment  Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  techVersion TechnologyVersion @relation(fields: [techVersionId], references: [id], onDelete: Cascade)

  @@id([deploymentId, techVersionId])
  @@index([techVersionId])
  @@map("deployment_component")
}

model ComponentChange {
  id            String              @id @default(uuid(7)) @db.Uuid
  deploymentId  String              @map("deployment_id") @db.Uuid
  technologyId  String              @map("technology_id") @db.Uuid
  fromVersionId String?             @map("from_version_id") @db.Uuid
  toVersionId   String?             @map("to_version_id") @db.Uuid
  fromVersion   String?             @map("from_version")
  toVersion     String?             @map("to_version")
  changeType    ComponentChangeType @map("change_type")
  reason        ChangeReason        @default(PLANNED_UPGRADE)
  ticketRef     String?             @map("ticket_ref")
  evidenceUrl   String?             @map("evidence_url")
  sequence      Int
  hash          String
  previousHash  String?             @map("previous_hash")
  correctsId    String?             @map("corrects_id") @db.Uuid
  effectiveAt   DateTime            @map("effective_at") @db.Date
  recordedAt    DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedById  String?             @map("recorded_by_id") @db.Uuid
  note          String?

  deployment  Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  technology  Technology         @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  fromVersion_ TechnologyVersion? @relation("ChangeFrom", fields: [fromVersionId], references: [id], onDelete: SetNull)
  toVersion_   TechnologyVersion? @relation("ChangeTo", fields: [toVersionId], references: [id], onDelete: SetNull)
  recordedBy  AppUser?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  corrects    ComponentChange?   @relation("Corrections", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy ComponentChange[]  @relation("Corrections")

  @@unique([deploymentId, sequence])
  @@index([deploymentId, effectiveAt])
  @@index([technologyId, effectiveAt])
  @@map("component_change")
}


model Team {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @unique
  email           String?
  teamsWebhookUrl String?   @map("teams_webhook_url")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members        TeamMember[]
  ownedDeployments DeploymentOwner[]
  upgradeActions UpgradeAction[]

  @@map("team")
}

model AppUser {
  id          String    @id @default(uuid(7)) @db.Uuid
  entraOid    String?   @unique @map("entra_oid")
  email       String    @unique
  displayName String?   @map("display_name")
  passwordHash String?  @map("password_hash")
  role        Role      @default(VIEWER)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  teams           TeamMember[]
  projects        ProjectEngineer[]
  assignedActions UpgradeAction[]
  recordedChanges ComponentChange[]
  auditLogs       AuditLog[]

  @@map("app_user")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  team Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}


model UpgradeAction {
  id                String       @id @default(uuid(7)) @db.Uuid
  technologyCycleId String       @map("technology_cycle_id") @db.Uuid
  teamId            String?      @map("team_id") @db.Uuid
  assigneeId        String?      @map("assignee_id") @db.Uuid
  targetVersion     String?      @map("target_version")
  plannedDate       DateTime?    @map("planned_date") @db.Date
  completedDate     DateTime?    @map("completed_date") @db.Date
  status            ActionStatus @default(NOT_STARTED)
  jiraKey           String?      @map("jira_key")
  jiraIssueId       String?      @map("jira_issue_id")
  jiraUrl           String?      @map("jira_url")
  jiraStatus        String?      @map("jira_status")
  jiraStatusCategory String?     @map("jira_status_category")
  jiraAssignee      String?      @map("jira_assignee")
  jiraSubtaskDone   Int?         @map("jira_subtask_done")
  jiraSubtaskTotal  Int?         @map("jira_subtask_total")
  jiraSyncedAt      DateTime?    @map("jira_synced_at") @db.Timestamptz(3)
  jiraSyncError     String?      @map("jira_sync_error")
  customerComm      CommStatus   @default(NOT_REQUIRED) @map("customer_comm")
  customerCommNotes String?      @map("customer_comm_notes")
  remarks           String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  cycle         TechnologyCycle           @relation(fields: [technologyCycleId], references: [id], onDelete: Restrict)
  team          Team?                     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee      AppUser?                  @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  deployments   UpgradeActionDeployment[]
  jiraSubtasks  JiraSubtask[]
  notifications NotificationLog[]

  @@index([status, plannedDate])
  @@index([technologyCycleId])
  @@index([assigneeId])
  @@map("upgrade_action")
}


model UpgradeActionDeployment {
  upgradeActionId String @map("upgrade_action_id") @db.Uuid
  deploymentId    String @map("deployment_id") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Date

  upgradeAction UpgradeAction @relation(fields: [upgradeActionId], references: [id], onDelete: Cascade)
  deployment    Deployment    @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@id([upgradeActionId, deploymentId])
  @@index([deploymentId])
  @@map("upgrade_action_deployment")
}


model NotificationRule {
  id            String   @id @default(uuid(7)) @db.Uuid
  thresholdDays Int      @unique @map("threshold_days")
  emailEnabled  Boolean  @default(true) @map("email_enabled")
  teamsEnabled  Boolean  @default(true) @map("teams_enabled")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_rule")
}

model NotificationLog {
  id                String    @id @default(uuid(7)) @db.Uuid
  technologyCycleId String    @map("technology_cycle_id") @db.Uuid
  upgradeActionId   String?   @map("upgrade_action_id") @db.Uuid
  referenceDate     DateTime  @map("reference_date") @db.Date
  thresholdDays     Int       @map("threshold_days")
  recipient         String
  channel           Channel
  success           Boolean
  error             String?
  sentAt            DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)

  cycle         TechnologyCycle @relation(fields: [technologyCycleId], references: [id], onDelete: Cascade)
  upgradeAction UpgradeAction?  @relation(fields: [upgradeActionId], references: [id], onDelete: SetNull)

  @@unique([technologyCycleId, referenceDate, thresholdDays, recipient, channel])
  @@index([sentAt])
  @@map("notification_log")
}


model EolSyncLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  technologyId String?   @map("technology_id") @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  success      Boolean   @default(false)
  changes      Int       @default(0)
  error        String?
  rawResponse  Json?     @map("raw_response")

  technology Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@map("eol_sync_log")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entity     String
  entityId   String?  @map("entity_id")
  action     String
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model JiraSubtask {
  id              String   @id @default(uuid(7)) @db.Uuid
  upgradeActionId String   @map("upgrade_action_id") @db.Uuid
  issueKey        String   @map("issue_key")
  issueId         String   @map("issue_id")
  summary         String
  status          String
  statusCategory  String   @map("status_category")
  assignee        String?
  url             String
  position        Int
  syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  upgradeAction UpgradeAction @relation(fields: [upgradeActionId], references: [id], onDelete: Cascade)

  @@unique([upgradeActionId, issueId])
  @@index([upgradeActionId, position])
  @@map("jira_subtask")
}
