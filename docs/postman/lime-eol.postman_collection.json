{
  "info": {
    "name": "Lime EOL Registry API",
    "description": "Manual test collection for the Lime Technology Lifecycle & EOL Registry API.\n\nUsage:\n1. Import this collection and `lime-eol.local.postman_environment.json`.\n2. Select the **Lime EOL - Local** environment.\n3. Start the stack: `docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build`.\n4. Run **System / Health** first — it must return status \"ok\".\n\nRequests are grouped by the delivery phase that implements them. Folders marked *(Phase n)* return 404 until that phase is done.\n\nAuthentication: run **Auth / Dev login**; its test script stores the JWT in the `token` environment variable and every other request inherits it as a bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is reasonable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "docsUrl",
      "value": "http://localhost:3000/api/docs-json",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "description": "Public endpoints — no token required.",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Application + database health. Returns 200 with status \"ok\", or 503 with status \"error\" when the database is unreachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Overall status is ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('Database is up', function () {",
                  "    pm.expect(pm.response.json().info.database.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Swagger JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{docsUrl}}",
              "host": ["{{docsUrl}}"]
            },
            "description": "The generated OpenAPI document. Useful to re-import the API into Postman as endpoints are added."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Is an OpenAPI document', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('openapi');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "EOL data source",
      "description": "Live lookups against endoflife.date. No database needed — these work today and are how you find a product slug and its cycles before registering a technology.",
      "item": [
        {
          "name": "List products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products?q=&category=",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products"],
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "description": "Filter on slug, label or alias (e.g. mongo)"
                },
                {
                  "key": "category",
                  "value": "",
                  "description": "e.g. database, framework, os, server-app"
                }
              ]
            },
            "description": "Every product endoflife.date tracks (~475). Cached for an hour."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns products with a slug', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body[0]).to.have.property('slug');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List products in a category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products?category=database",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products"],
              "query": [{ "key": "category", "value": "database" }]
            },
            "description": "Narrowed at the source (GET /categories/{category}) rather than by filtering all 475 products."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Every product is in the category', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach(function (p) {",
                  "        pm.expect(p.category).to.eql('database');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/categories",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "categories"]
            },
            "description": "The nine categories products are grouped into."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Includes database', function () {",
                  "    pm.expect(pm.response.json()).to.include('database');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Tags",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/tags",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "tags"]
            },
            "description": "88 tags, e.g. javascript-runtime, apache, managed-kubernetes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Latest cycle - Node.js",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/nodejs/releases/latest",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "nodejs", "releases", "latest"]
            },
            "description": "The newest cycle — the upgrade target to suggest when planning an action."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns a single cycle', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('cycle');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Single cycle - MongoDB 6.0 (already EOL)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/mongodb/releases/6.0",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "mongodb", "releases", "6.0"]
            },
            "description": "How a registered version is checked against the source. MongoDB 6.0 went EOL on 2025-07-31, so daysToEol is negative."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Past EOL shows a negative daysToEol', function () {",
                  "    pm.expect(pm.response.json().daysToEol).to.be.below(0);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Unknown cycle returns 404",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/nodejs/releases/99",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "nodejs", "releases", "99"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Product cycles - Node.js",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/nodejs",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "nodejs"]
            },
            "description": "Release cycles with lifecycle dates already mapped to the registry's fields, plus daysToEol."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cycles carry lifecycle dates', function () {",
                  "    const release = pm.response.json().releases[0];",
                  "    pm.expect(release).to.have.property('cycle');",
                  "    pm.expect(release).to.have.property('eolDate');",
                  "    pm.expect(release).to.have.property('daysToEol');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Product cycles - MongoDB (major.minor)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/mongodb",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "mongodb"]
            },
            "description": "MongoDB publishes major.minor cycles (8.0, 7.0, 6.0), which is why its cycleRule is MAJOR_MINOR."
          },
          "response": []
        },
        {
          "name": "Product cycles - active support as EOL",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/nodejs?eolField=eoas",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "nodejs"],
              "query": [
                {
                  "key": "eolField",
                  "value": "eoas",
                  "description": "eol (security support) | eoas (active support) | eoes (extended support)"
                }
              ]
            },
            "description": "For a team that will not run security-only builds, active support end is the deadline that matters. Compare cycle 24's eolDate with the default request."
          },
          "response": []
        },
        {
          "name": "Unknown product returns 404",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/eol/products/not-a-real-thing",
              "host": ["{{baseUrl}}"],
              "path": ["eol", "products", "not-a-real-thing"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth (Phase 3)",
      "description": "Not implemented yet — these return 404 until Phase 3 lands.",
      "item": [
        {
          "name": "Dev login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@linearsix.com\",\n    \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            },
            "description": "Local-only login. Returns a JWT signed with DEV_JWT_SECRET. Blocked when NODE_ENV=production."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const token = pm.response.json().accessToken;",
                  "    pm.environment.set('token', token);",
                  "    pm.test('Token stored in environment', function () {",
                  "        pm.expect(token).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Current user, role and teams. Requires a bearer token."
          },
          "response": []
        }
      ]
    }
  ]
}
